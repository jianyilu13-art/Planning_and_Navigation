<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_init</name>
  <version>1.0.0</version>
  <description>Starts the RB3302 robot-side nodes for mapping and planning</description>
  <maintainer email="ldaowen@gmail.com">ldaowen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>yesense_std_ros2</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>robot_model</exec_depend>
  <exec_depend>waverover_base</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
